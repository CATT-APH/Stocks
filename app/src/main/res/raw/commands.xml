<?xml version="1.0" encoding="UTF-8"?>
<!--
Maps physical Monarch controls to Android keycodes so they reach onKeyDown.
Nothing is auto-forwarded on this hardware, so every keycode needs its own
entry here or it never arrives.

StocksApplication hands this file to KeySoft on launch.

Panning Down opens Details and Panning Up returns, using a global context
(viewIdResourceName="*"). The app receives keycodes 420 (Up) and 421 (Down),
not the param values below. This is not always reliable on the device.
Zoom In/Out are reserved by the screen reader and are not mapped here.
-->
<keymapping>
    <application package="org.aph.stocks">
        <context viewIdResourceName="*">
            <action name="substitute">
                <command commandId="panning_up" param="303" string="context_menu_panning_up">
                    <key>PanningUp</key>
                </command>
                <command commandId="panning_down" param="304" string="context_menu_panning_down">
                    <key>PanningDown</key>
                </command>
            </action>
        </context>
    </application>
</keymapping>
